# Copia este archivo como .env.local y completa los valores. .env.local nunca se sube a git.

# Dirección de tu proyecto de Supabase y su clave pública (anon o "publishable").
# Estas dos llegan al navegador: son públicas por diseño. Lo que protege tus datos son las políticas
# de la base (sin sesión no se ve ni una fila).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Clave secreta (service_role o "secret"). Solo la usan los scripts de tu computadora (crear usuarios).
# NUNCA le pongas VITE_ adelante: eso la mandaría al navegador.
SUPABASE_SERVICE_ROLE_KEY=
